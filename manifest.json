{
    "manifest_version": 3,
    "name": "Custom Tab",
    "version": "1.2.0",
    "description": "Open your configured website in every new tab.",
    "permissions": ["storage", "tabs"],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "chrome_url_overrides": {
        "newtab": "newtab.html"
    },
    "action": {
        "default_title": "Custom New Tab Settings",
        "default_popup": "settings.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png"
        }
    }
}
